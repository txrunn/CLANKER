# Instance configuration and secrets for the operator workstation.
#
#   just env        # copies this to .env (0600) and generates the keys
#
# .env is gitignored and must never be committed: this repo is public
# (README "A note on publishing", SECURITY-MODEL SEC-9). Everything that
# identifies a specific house lives here and only here.

# --- Instance: where the Spark is ------------------------------------------
# Read by Terraform as TF_VAR_* and validated in modules/spark-host.

TF_VAR_spark_host=spark.local
TF_VAR_ssh_port=22
TF_VAR_admin_user=admin
# HCL lists. LAN = what tenants may reach; clients = who may call tenant ports.
TF_VAR_lan_cidrs='["192.168.1.0/24"]'
TF_VAR_client_cidrs='["192.168.1.10/32", "192.168.1.20/32"]'
# Set false to render/plan only and converge with `just converge`.
TF_VAR_converge_on_apply=true

# --- Privilege escalation for non-interactive converges --------------------
# terraform apply cannot answer a sudo prompt. Point this at a 0600 file
# outside the repo holding the admin user's sudo password, or leave it empty
# and use `just converge` (prompts) instead.
ANSIBLE_BECOME_PASSWORD_FILE=

# --- Secrets ----------------------------------------------------------------
# Generated by `just env`. Rotate by changing the value and running
# `just converge`; services restart with the new key.

# Shared key for the vLLM endpoints (SEC-8: the LAN is not a trust boundary).
CLANKER_INFERENCE_API_KEY=
# Qdrant API key.
CLANKER_QDRANT_API_KEY=

# Optional: only needed for gated Hugging Face repos during `just pull`.
HF_TOKEN=
