# {{ ansible_managed }}
# Inference endpoints for svc-{{ item }}. Private (0600). Source this in jobs.
# Contract: docs/MODEL-CATALOG.md §4 (priority, determinism, provenance).
INFERENCE_API_KEY={{ lookup('ansible.builtin.env', inference_platform_api_key_env) }}
{% for key, m in spark_models.items() if item in m.consumers %}
INFERENCE_{{ key | upper | replace('-', '_') }}_URL=http://127.0.0.1:{{ m.port }}/v1
INFERENCE_{{ key | upper | replace('-', '_') }}_MODEL={{ m.alias }}
{% endfor %}
